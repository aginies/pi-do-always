{
	"name": "pi-do-always",
	"version": "0.4.4",
	"type": "module",
	"description": "Pi extension: /do-always — pick a common task by number, it fills your prompt",
	"author": {
		"name": "aginies",
		"email": "antoine@ginies.org"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"do-always"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/aginies/pi-do-always",
		"directory": "extensions/pi-do-always"
	},
	"homepage": "https://github.com/aginies/pi-do-always",
	"bugs": {
		"url": "https://github.com/aginies/pi-do-always/issues"
	},
	"files": [
		"extensions/pi-do-always/index.ts",
		"extensions/pi-do-always/tasks.ts",
		"extensions/pi-do-always/do-always.json",
		"README.md",
		"pi.image.png"
	],
	"pi": {
		"extensions": [
			"./extensions/pi-do-always/index.ts"
		],
		"image": "pi.image.png"
	},
	"scripts": {
		"dev": "pi --extension ./extensions/pi-do-always/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test extensions/pi-do-always/test/*.test.ts",
		"prepublishOnly": "npm run typecheck && npm test"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.5.0"
	}
}
