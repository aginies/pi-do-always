{
	"name": "pi-do-always",
	"version": "0.2.0",
	"type": "module",
	"description": "Pi extension: /do-always — pick a common task by number, it fills your prompt",
	"keywords": [
		"pi-package",
		"pi-extensions",
		"do-always"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/aginies/pi-always"
	},
	"homepage": "https://github.com/aginies/pi-always",
	"bugs": {
		"url": "https://github.com/aginies/pi-always/issues"
	},
	"files": [
		"index.ts",
		"tasks.ts",
		"do-always.json",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"dev": "pi --extension ./index.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test test/**/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1",
		"@types/node": "^22.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.5.0"
	}
}
